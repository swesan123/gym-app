NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only: used by all Next.js server actions/pages, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI chat (server-only). Set a credit limit on the OpenRouter key.
OPENROUTER_API_KEY=sk-or-your-key
# Optional: any OpenRouter model id with tool-calling support.
OPENROUTER_MODEL=openai/gpt-6-luna
# Required in production (32+ chars). Signs tool-approval responses so a modified client cannot forge approvals.
# Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Passcode gate for the whole app (server-only). Required in production (8+ chars).
APP_PASSCODE=
# Required in production (32+ chars). Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
